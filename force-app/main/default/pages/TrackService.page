<apex:page controller="TrackServiceRequestController" showHeader="false">
    <apex:form >
        <!-- Display any page messages like errors or success messages -->
        <apex:pageMessages />

        <!-- Main content container -->
        <apex:pageBlock title="Track Your Service Requests">
            
            <!-- List of Service Requests -->
            <apex:pageBlockTable value="{!serviceRequests}" var="sr">
                <apex:column headerValue="Service Number">
                    <apex:outputLink value="{!URLFOR($Action.Service_Request__c.View, sr.Id)}">
                        {!sr.Service_Number__c}
                    </apex:outputLink>
                </apex:column>
                <apex:column value="{!sr.Product__c}" headerValue="Product"/>
                <apex:column value="{!sr.Service_Type__c}" headerValue="Service Type"/>
                <apex:column value="{!sr.Service_Date__c}" headerValue="Service Date"/>
                <apex:column value="{!sr.Status__c}" headerValue="Status"/>
                <apex:column headerValue="Actions">
                    <apex:commandLink value="View Details" action="{!viewDetails}">
                        <apex:param name="recordId" value="{!sr.Id}" assignTo="{!selectedServiceRequestId}"/>
                    </apex:commandLink>
                </apex:column>
            </apex:pageBlockTable>

            <!-- Detailed View of Selected Service Request -->
            <apex:pageBlock title="Service Request Details" rendered="{!NOT(ISNULL(selectedServiceRequest))}">
                <apex:pageBlockSection columns="1">
                    <apex:outputField value="{!selectedServiceRequest.Service_Number__c}" label="Service Number"/>
                    <apex:outputField value="{!selectedServiceRequest.Product__c}" label="Product"/>
                    <apex:outputField value="{!selectedServiceRequest.Service_Type__c}" label="Service Type"/>
                    <apex:outputField value="{!selectedServiceRequest.Service_Location__c}" label="Service Location"/>
                    <apex:outputField value="{!selectedServiceRequest.Description__c}" label="Description"/>
                    <apex:outputField value="{!selectedServiceRequest.Service_Date__c}" label="Service Date"/>
                    <apex:outputField value="{!selectedServiceRequest.Status__c}" label="Status"/>
                    <apex:outputField value="{!selectedServiceRequest.Customer__c}" label="Customer"/>
                    <apex:outputField value="{!selectedServiceRequest.Service_Center__c}" label="Service Center"/>
                </apex:pageBlockSection>
            </apex:pageBlock>
        </apex:pageBlock>
    </apex:form>
</apex:page>