<apex:page >
    <div class="header">
        <div class="logo">
            <img src="path_to_logo" alt="Logo"/>
        </div>
        <div class="search-bar">
            <input type="text" placeholder="Search..."/>
        </div>
        <div class="cart-icon">
            <apex:outputLink value="{!URLFOR($Page.ViewCartPage)}">
                <img src="path_to_cart_icon" alt="Cart"/>
            </apex:outputLink>
        </div>
    </div>
</apex:page>